{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oss-funder.example/contracts/modules/module-registration.v1.schema.json",
  "title": "OSS-Funder module registration v1",
  "description": "Target registration contract for modules. The current Rust endpoint still accepts omitted requirements and does not enforce the cross-field selector rule; this schema defines the approved v1 shape that implementation must adopt.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "endpoint", "requirements"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": ["string", "null"]
    },
    "endpoint": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://.+$",
      "description": "HTTP(S) module invocation endpoint; deployment safety and SSRF checks remain backend responsibilities."
    },
    "health_endpoint": {
      "type": ["string", "null"],
      "format": "uri",
      "pattern": "^https?://.+$"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600,
      "default": 120
    },
    "delivery_mode": {
      "type": "string",
      "enum": ["manifest", "archive", "both"],
      "default": "manifest"
    },
    "requirements": {
      "$ref": "#/$defs/module_requirements"
    }
  },
  "$defs": {
    "module_requirements": {
      "type": "object",
      "additionalProperties": false,
      "description": "Canonical requirements must be present in full. This prevents omitted fields from bypassing selector validation.",
      "required": [
        "required_roles",
        "languages",
        "include_globs",
        "exclude_globs",
        "requires_git_history",
        "requires_full_repository"
      ],
      "properties": {
        "required_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["license", "manifest", "lockfile", "source", "test", "documentation", "configuration", "other"]
          }
        },
        "languages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "include_globs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exclude_globs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "requires_git_history": {
          "type": "boolean",
          "default": false
        },
        "requires_full_repository": {
          "type": "boolean",
          "default": false
        },
        "max_files": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "max_bytes": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "requires_full_repository": { "const": true } }
          },
          "then": {
            "properties": {
              "required_roles": { "maxItems": 0 },
              "languages": { "maxItems": 0 },
              "include_globs": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "requires_full_repository": { "const": false } }
          },
          "then": {
            "anyOf": [
              { "properties": { "required_roles": { "minItems": 1 } } },
              { "properties": { "languages": { "minItems": 1 } } },
              { "properties": { "include_globs": { "minItems": 1 } } }
            ]
          }
        }
      ]
    }
  }
}
