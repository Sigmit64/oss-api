{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oss-funder.example/contracts/modules/module-result.v1.schema.json",
  "title": "OSS-Funder module result v1 (approved contract; implementation pending)",
  "description": "Approved version 1 synchronous HTTP JSON result contract. The current Rust backend does not yet validate or interpret this schema: today a 2xx response is recorded as completed and its bounded body is stored. V1 accepts only inline artifact delivery. The complete HTTP response body, including JSON and base64 overhead, is limited to 16 MiB; an oversized response must fail rather than be truncated. Larger delivery methods are reserved for a later contract version. A partial_success result must contain at least one valid finding or artifact and at least one non-fatal error describing an uncovered or incomplete portion; it is not a completely failed run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "run_id", "status", "summary", "findings", "artifacts", "errors"],
  "properties": {
    "contract_version": { "const": "1" },
    "run_id": { "type": "string", "format": "uuid" },
    "status": {
      "type": "string",
      "enum": ["completed", "partial_success", "failed"],
      "description": "completed means the module completed without errors; partial_success means at least one finding or artifact was produced while an uncovered or non-fatal error remains; failed means no successful completion claim can be made and errors explain the failure."
    },
    "summary": {
      "type": "object",
      "description": "Module-specific counters and summary fields. The result envelope remains closed while summary is an explicit extension point.",
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/error" }
    }
  },
  "allOf": [
    {
      "if": { "required": ["status"], "properties": { "status": { "const": "failed" } } },
      "then": { "properties": { "errors": { "minItems": 1 } } }
    },
    {
      "if": { "required": ["status"], "properties": { "status": { "const": "completed" } } },
      "then": { "properties": { "errors": { "maxItems": 0 } } }
    },
    {
      "if": { "required": ["status"], "properties": { "status": { "const": "partial_success" } } },
      "then": {
        "properties": { "errors": { "minItems": 1 } },
        "anyOf": [
          { "properties": { "findings": { "minItems": 1 } } },
          { "properties": { "artifacts": { "minItems": 1 } } }
        ]
      }
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "kind", "subject", "title", "evidence"],
      "properties": {
        "finding_id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["vulnerability", "license", "other"] },
        "subject": {
          "type": "object",
          "description": "Component, file, package, or other affected subject.",
          "additionalProperties": true
        },
        "title": { "type": "string" },
        "severity": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "value"],
            "properties": {
              "type": { "type": "string" },
              "value": { "type": "string" },
              "path": {
                "type": ["string", "null"],
                "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$)).+$",
                "description": "Optional safe POSIX repository-relative evidence path."
              },
              "line": { "type": ["integer", "null"], "minimum": 1 }
            }
          }
        },
        "fact_status": { "type": ["string", "null"], "enum": ["confirmed", "not_covered", "scan_failed", null] },
        "policy_status": { "type": ["string", "null"], "enum": ["pending", "pass", "fail", "waived", null] },
        "disposition": { "type": ["string", "null"] }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "filename", "media_type", "delivery"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "filename": { "type": "string", "pattern": "^(?!\\.{1,2}$)[^/\\\\]+$", "description": "Safe output basename; path separators are not allowed." },
        "media_type": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 0 },
        "delivery": {
          "description": "How the artifact is delivered. V1 accepts only inline content; future contract versions may add upload_session, backend_upload, or controlled_url without changing this outer artifact shape.",
          "$ref": "#/$defs/inline_delivery"
        }
      }
    },
    "inline_delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "content"],
      "properties": {
        "method": { "const": "inline" },
        "content": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["format", "value"],
              "properties": {
                "format": { "const": "json" },
                "value": {}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["format", "value"],
              "properties": {
                "format": { "const": "text" },
                "value": { "type": "string" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["format", "value"],
              "properties": {
                "format": { "const": "base64" },
                "value": { "type": "string", "contentEncoding": "base64" }
              }
            }
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "subject": { "type": ["string", "null"] }
      }
    }
  }
}
